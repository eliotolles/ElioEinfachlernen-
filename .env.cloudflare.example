# TEMPLATE ONLY. Sites masks existing secrets; this is NOT a full secret export.
# Enter values in Cloudflare Worker Settings > Variables and Secrets.
# Use the SAME Turso database to retain accounts and study data.
TURSO_DATABASE_URL=libsql://YOUR_EXISTING_DATABASE.turso.io
TURSO_AUTH_TOKEN=REPLACE_WITH_NEW_TOKEN_FOR_EXISTING_DATABASE
# Preserve the original encryption key if you have saved it.
# Otherwise generate a new key and re-enter AI provider keys in the new Admin UI.
AI_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_SECRET
ADMIN_EMAILS=REPLACE_WITH_YOUR_ADMIN_EMAILS
# Existing accounts retain their current passwords. No initial password is needed.
# Set this only when seeding a brand-new database, using a private password.
# ADMIN_INITIAL_PASSWORD=

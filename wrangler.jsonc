{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elio-einfach",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "build": { "command": "npm run build:cloudflare" },
  "observability": { "enabled": false }
}

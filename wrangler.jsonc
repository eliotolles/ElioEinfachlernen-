{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elio-einfach-lernen",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build:cloudflare"
  },
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./cloudflare/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/",
      "/hoeren",
      "/hoeren.html"
    ]
  }
}

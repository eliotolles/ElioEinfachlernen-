{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "vercel-public",
  "functions": {
    "api/handler.js": {
      "maxDuration": 300
    },
    "api/transcript.py": {
      "maxDuration": 120,
      "excludeFiles": "{public/**,vercel-public/**,artwork/**,tests/**,services/transcript/tests/**,.git/**}"
    }
  },
  "routes": [
    {
      "src": "/api/transcript/?",
      "dest": "/api/transcript"
    },
    {
      "src": "/api(?:/.*)?",
      "dest": "/api/handler"
    },
    {
      "src": "/(?:home(?:\\.html)?|hoeren(?:\\.html)?|robots\\.txt|sitemap\\.xml)?",
      "dest": "/api/handler"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/([^./]+)",
      "dest": "/$1.html"
    }
  ]
}
